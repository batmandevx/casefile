generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Investigation {
  id              String   @id @default(cuid())
  runId           String   @unique
  question        String
  startedAt       DateTime @default(now())
  endedAt         DateTime?
  queryBudget     Int      @default(60)
  queriesUsed     Int      @default(0)
  totalRowsScanned Int     @default(0)
  totalDbMs       Float    @default(0)
  finalFinding    String?
  finalConfidence Float?
  hypotheses      Hypothesis[]
  createdAt       DateTime @default(now())
}

model Hypothesis {
  id            String   @id @default(cuid())
  hypId         String   @unique
  runId         String
  parentId      String?
  depth         Int      @default(0)
  statement     String
  rationale     String?
  sqlText       String?
  rowsReturned  Int      @default(0)
  rowsScanned   Int      @default(0)
  dbMs          Float    @default(0)
  resultSummary String?
  verdict       String?  // CONFIRMED / REFUTED / INCONCLUSIVE / ERROR
  confidence    Float    @default(0)
  reasoning     String?
  createdAt     DateTime @default(now())
  investigation Investigation @relation(fields: [runId], references: [runId])
}